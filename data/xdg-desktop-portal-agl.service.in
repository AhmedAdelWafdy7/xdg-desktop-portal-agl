[Unit]
Description=XDG Desktop Portal for AGL
PartOf=graphical-session.target
After=graphical-session.target
After=xdg-desktop-portal.service

[Service]
Type=dbus
BusName=org.freedesktop.impl.portal.desktop.agl
ExecStart=@LIBEXECDIR@/xdg-desktop-portal-agl
Restart=on-failure
RestartSec=1
#MemoryMax=32M
Slice=session.slice