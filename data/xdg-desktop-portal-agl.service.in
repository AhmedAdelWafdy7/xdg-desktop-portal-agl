[Unit]
Description=XDG Desktop Portal for AGL
PartOf=graphical-session.target
After=graphical-session.target
Before=xdg-desktop-portal.service

[Service]
Type=dbus
BusName=org.freedesktop.impl.portal.desktop.agl
ExecStart=/usr/libexec/xdg-desktop-portal-agl
Restart=on-failure
TimeoutStopSec=5

[Install]
WantedBy=xdg-desktop-portal.service