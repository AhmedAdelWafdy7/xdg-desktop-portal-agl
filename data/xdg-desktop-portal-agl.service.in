[Unit]
Description=XDG Desktop Portal backend for AGL
PartOf=graphical-session.target
After=graphical-session.target
After=weston-environment.service
Requisite=graphical-session.target
Before=xdg-desktop-portal.service

[Service]
Type=dbus
BusName=org.freedesktop.impl.portal.desktop.agl
ExecStart=/usr/libexec/xdg-desktop-portal-agl
Restart=on-failure
RestartSec=5
TimeoutStopSec=5
PassEnvironment=WAYLAND_DISPLAY
PassEnvironment=XDG_CURRENT_DESKTOP
PassEnvironment=DBUS_SESSION_BUS_ADDRESS

[Install]
WantedBy=xdg-desktop-portal.service